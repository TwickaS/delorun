{
  "name": "@delorun/website",
  "version": "0.0.0",
  "description": "Delorun's product website: a short home page and a privacy page, built as a static site.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node ../../packages/site-design/scripts/write-looks.ts --check && vite build && tsc --noEmit && node ../docs/scripts/check-links.mjs out && node scripts/check-weight.ts out",
    "dev": "vite dev",
    "preview": "node ../docs/scripts/serve-static.mjs out",
    "typecheck:deploy": "tsc --noEmit -p tsconfig.deploy.json",
    "generate": "node ../../packages/site-design/scripts/write-looks.ts"
  },
  "dependencies": {
    "@delorun/site-design": "link:../../packages/site-design",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "clsx": "2.1.1",
    "fumadocs-core": "16.17.8",
    "fumadocs-ui": "16.17.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@effect/platform-node": "4.0.7",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "delorun": {
    "state": "shipped"
  }
}
