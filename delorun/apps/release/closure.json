{
  "schema": "delorun.release-closure/1",
  "platforms": [
    "linux-x64",
    "linux-arm64"
  ],
  "buildRoot": "/var/tmp/delorun-release-build",
  "deployRoot": "@delorun/runtime-closure",
  "clientTitle": "Delorun",
  "foreignPrebuilds": [
    {
      "package": "@deepseek-ai/libreoffice-kit",
      "directory": "frame-forwarding/prebuilds",
      "platforms": [
        "darwin-arm64",
        "darwin-x64",
        "win32-arm64",
        "win32-x64"
      ]
    }
  ],
  "packExternals": [
    "@anthropic-ai/claude-agent-sdk-*",
    "@openai/codex-*",
    "@anthropic-ai/sdk"
  ],
  "anchor": {
    "package": "@deepseek-ai/dsh",
    "bundles": [
      "@delorun/bundle-local",
      "@delorun/bundle-studio"
    ]
  }
}
