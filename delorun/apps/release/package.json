{
  "name": "@delorun/release",
  "description": "Delorun's release tooling: the changelog gate and release-notes assembly, the deterministic runtime closure build, the rebuild comparison, signing and verification of release metadata, the SBOM and the dependency advisory check.",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    "./closure/*": "./src/closure/*.ts",
    "./log/*": "./src/log/*.ts",
    "./sign/*": "./src/sign/*.ts",
    "./tests/*": "./tests/*.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@delorun/changes": "workspace:*",
    "@delorun/contract-plugin-versions": "workspace:*",
    "@delorun/contract-release-log": "workspace:*",
    "@delorun/contract-release-manifest": "workspace:*",
    "@delorun/contract-update-report": "workspace:*",
    "@delorun/release-formats": "workspace:*",
    "@delorun/runtime-closure": "workspace:*",
    "@delorun/runtime-store": "workspace:*",
    "@delorun/tools": "workspace:*",
    "@delorun/update": "workspace:*",
    "@noble/curves": "^2.4.0",
    "extract-zip": "^2.0.1",
    "ignore": "^7.0.8",
    "semver": "^7.8.5",
    "tar": "^7.5.22",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-llm-mock-server": "workspace:*",
    "@delorun/bundle-local": "workspace:*",
    "@delorun/release-verify": "workspace:*",
    "@types/semver": "^7.8.0"
  },
  "delorun": {
    "state": "shipped"
  }
}
