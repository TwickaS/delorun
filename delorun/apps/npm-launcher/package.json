{
  "name": "@delorun/npm-launcher",
  "description": "The Delorun launcher npm serves as `delorun`: it verifies and installs the release its channel names through @delorun/install, refuses a runtime it cannot verify, and starts the installed runtime through its own Node executable (contract C1's launch protocol 1)",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "delorun": "tsx src/entry.ts",
    "pack:launcher": "tsx src/build.ts"
  },
  "dependencies": {
    "@delorun/contract-home-layout": "workspace:*",
    "@delorun/contract-release-manifest": "workspace:*",
    "@delorun/contract-update-report": "workspace:*",
    "@delorun/contract-verification-checks": "workspace:*",
    "@delorun/home": "workspace:*",
    "@delorun/install": "workspace:*",
    "@delorun/logs": "workspace:*",
    "@delorun/release-formats": "workspace:*",
    "@delorun/release-verify": "workspace:*",
    "@delorun/runtime-store": "workspace:*",
    "@delorun/update": "workspace:*",
    "semver": "^7.8.5"
  },
  "delorun": {
    "state": "shipped"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@types/semver": "^7.8.0",
    "tsdown": "^0.22.2"
  }
}
