{
  "name": "@delorun/plugin-workspaces",
  "description": "Delorun's workspaces service (delorunWorkspaces): new workspace folders, repositories cloned by git with the person's own credential, AGENTS.md read and write, and the trash",
  "version": "0.0.0",
