{
  "name": "@delorun/bundle-local",
  "description": "Delorun's local bundle: the layer that Delorun's CLI profiles add over upstream's web template, with Delorun's privacy defaults for upstream's opt-ins and the Privacy section in Settings",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./profile": "./src/profile.ts",
    "./rows": "./src/rows.ts",
    "./update-gate": "./src/update-gate.ts",
    "./workspace-rename": "./src/workspace-rename.ts",
    "./prompt-wording": "./src/prompt-wording.ts",
    "./update-check": "./src/update-check.ts",
    "./trust": "./src/trust.ts",
    "./pin-api": "./src/client/pin-api.ts",
    "./pin-rules": "./src/client/pin-rules.ts",
    "./host-api": "./src/client/host-api.ts",
    "./agent-limits": "./src/client/AgentLimits.tsx",
    "./agent-limits-locales": "./src/client/agent-limits-locales.ts",
    "./full-access": "./src/client/full-access.ts",
    "./profile-versions": "./src/profile-versions.ts",
    "./run-settings": "./src/run-settings.ts",
    "./requirements": "./src/requirements.ts",
    "./requirements-api": "./src/client/requirements-api.ts",
    "./browser-check-api": "./src/client/browser-check-api.ts",
    "./report": "./src/report.ts",
    "./statements": "./src/client/locales.ts",
    "./trust-bill": "./src/client/trust-bill.ts",
    "./trust-schema": "./src/client/trust-schema.ts",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "locale/*.json",
    "cordis.patch.yml",
    "src/profile.ts",
    "src/rows.ts",
    "src/update-gate.ts",
    "src/workspace-rename.ts",
    "src/prompt-wording.ts",
    "src/update-check.ts",
    "src/trust.ts",
    "src/trust-schedule.ts",
    "src/profile-versions.ts",
    "src/run-settings.ts",
    "src/studio-page.ts",
    "src/client/run-settings-api.ts",
    "src/requirements.ts",
    "src/client/requirements-api.ts",
    "src/browse-pairing.ts",
    "src/browser-check.ts",
    "src/client/browser-check-api.ts",
    "src/client/browse-pair-api.ts",
    "src/index.ts",
    "src/client/versions.ts",
    "src/report.ts",
    "src/client/report-api.ts",
    "src/client/versions-api.ts",
    "src/client/host-api.ts",
    "src/client/gate.ts",
    "src/client/AgentLimits.tsx",
    "src/client/AgentLimits.module.css",
    "src/client/agent-limits.ts",
    "src/client/agent-limits-api.ts",
    "src/client/agent-limits-locales.ts",
    "src/client/full-access.ts",
    "src/client/pin-api.ts",
    "src/client/pin-rules.ts",
    "src/client/devices-api.ts",
    "src/client/DevicesSection.module.css",
    "src/client/locales.ts",
    "src/client/trust-bill.ts",
    "src/client/trust-schema.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "typecheck": "tsc -b tsconfig.json && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.tests.client.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-atomic-write": "workspace:*",
    "@deepseek-ai/dsh-hmr": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-native-command": "workspace:*",
    "@deepseek-ai/dsh-official-bundles": "workspace:*",
    "@deepseek-ai/dsh-plugin-manager": "workspace:*",
    "@deepseek-ai/dsh-subprocess": "workspace:*",
    "@delorun/agent-claude-code": "workspace:*",
    "@delorun/agent-codex": "workspace:*",
    "@delorun/contract-reach-providers": "workspace:*",
    "@delorun/contract-setup-answers": "workspace:*",
    "@delorun/contract-update-report": "workspace:*",
    "@delorun/external-agents": "workspace:*",
    "@delorun/home-auth": "workspace:*",
    "@delorun/install": "workspace:*",
    "@delorun/logs": "workspace:*",
    "@delorun/plugin-agent-seats": "workspace:*",
    "@delorun/plugin-delegation-consent": "workspace:*",
    "@delorun/plugin-changes": "workspace:*",
    "@delorun/plugin-update": "workspace:*",
    "@delorun/plugin-packs": "workspace:*",
    "@delorun/plugin-fetch-guard": "workspace:*",
    "@delorun/plugin-install-check": "workspace:*",
    "@delorun/plugin-instruction-consent": "workspace:*",
    "@delorun/plugin-mcp-consent": "workspace:*",
    "@delorun/plugin-multiview": "workspace:*",
    "@delorun/plugin-permission-defaults": "workspace:*",
    "@delorun/plugin-schedule-consent": "workspace:*",
    "@delorun/plugin-tool-failure-guard": "workspace:*",
    "@delorun/plugin-trash": "workspace:*",
    "@delorun/profile-safety": "workspace:*",
    "@delorun/skill-plugin-authoring": "workspace:*",
    "@delorun/skill-report-problem": "workspace:*",
    "@delorun/reach": "workspace:*",
    "@delorun/brand": "workspace:*",
    "@delorun/settings-controls": "workspace:*",
    "@delorun/setup-apply": "workspace:*",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-user-approval": "workspace:*",
    "@deepseek-ai/dsh-workspace": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-agent-loop-testkit": "workspace:*",
    "@deepseek-ai/dsh-api-remotes": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-product-analytics": "workspace:*",
    "@deepseek-ai/dsh-client-store": "workspace:*",
    "@deepseek-ai/dsh-client-test-runtime": "workspace:*",
    "@deepseek-ai/dsh-client-ui-approval": "workspace:*",
    "@deepseek-ai/dsh-client-ui-chat": "workspace:*",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:*",
    "@deepseek-ai/dsh-client-ui-permission-presets": "workspace:*",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings-general": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-client-ui-workspace": "workspace:*",
    "@deepseek-ai/dsh-deepseek-llm-api-extensions": "workspace:*",
    "@deepseek-ai/dsh-host-product-telemetry-otel": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "workspace:*",
    "@deepseek-ai/dsh-llm-mock-server": "workspace:*",
    "@deepseek-ai/dsh-otel": "workspace:*",
    "@deepseek-ai/dsh-permission-presets": "workspace:*",
    "@deepseek-ai/dsh-sandbox": "workspace:*",
    "@deepseek-ai/dsh-sandbox-local": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-log-deepseek": "workspace:*",
    "@deepseek-ai/dsh-subprocess-local": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tool-executor-native": "workspace:*",
    "@deepseek-ai/dsh-tool-fs-search": "workspace:*",
    "@deepseek-ai/dsh-tool-testkit": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-user-approval": "workspace:*",
    "@deepseek-ai/dsh-workspace": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@delorun/contract-home-layout": "workspace:*",
    "@types/react": "~18.3.1",
    "js-yaml": "^4.3.2",
    "react": "^18.2.0",
    "tsdown": "^0.22.2"
  },
  "delorun": {
    "state": "shipped"
  }
}
