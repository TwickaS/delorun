{
  "name": "@delorun/bundle-agent-hooks",
  "description": "Claude Code and Codex hooks as an optional bundle: runs the hooks from your Claude Code settings and your Codex hooks file at the same points in a Delorun turn, and loads Claude Code mods. Off until the person turns it on",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-experimental-claude-code-mods": "workspace:*",
    "@deepseek-ai/dsh-experimental-client-ui-claude-code-mods": "workspace:*",
    "@deepseek-ai/dsh-hook-protocol": "workspace:*",
    "@deepseek-ai/dsh-hooks-claude-code": "workspace:*",
    "@deepseek-ai/dsh-hooks-codex": "workspace:*"
  },
  "delorun": {
    "state": "experimental",
    "pack": true
  }
}
