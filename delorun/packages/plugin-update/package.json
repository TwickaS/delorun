{
  "name": "@delorun/plugin-update",
  "description": "The studio's update: check now, prepare and apply an update with C3's report, go back, and stop Delorun, as Host routes that hand every step to the home process over its update channel",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./wire": "./src/wire.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@delorun/contract-home-process": "workspace:*",
    "@delorun/contract-update-report": "workspace:*",
    "@delorun/home-process": "workspace:*",
    "@delorun/plugin-changes": "workspace:*",
    "@delorun/update": "workspace:*",
    "semver": "^7.8.5"
  },
  "delorun": {
    "state": "shipped"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@delorun/bundle-local": "workspace:*",
    "@types/semver": "^7.8.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.host.json"
  }
}
