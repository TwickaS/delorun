{
  "name": "@delorun/plugin-changes",
  "description": "Delorun's hold on the agent's plugin changes, the check before every reload of a running profile, and the studio's Changes routes: a plugin_manager install_bundle or remove_bundle call records a change waiting for the person's review, other actions that change what runs are left to the person, no recomposition loads content the person did not approve, and the recovery screen and the Changes section in Settings read and act through routes that need the person at their computer",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./wire": "./src/wire.ts",
    "./face-grant": "./src/client/face-grant.ts",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.client.json && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.host.json && tsc -b tsconfig.client.json && tsc --noEmit -p tsconfig.tests.client.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-util-values": "workspace:*",
    "@delorun/archive": "workspace:*",
    "@delorun/brand": "workspace:*",
    "@delorun/changes": "workspace:*",
    "@delorun/contract-archive-and-trash": "workspace:*",
    "@delorun/contract-home-layout": "workspace:*",
    "@delorun/contract-plugin-versions": "workspace:*",
    "@delorun/home": "workspace:*",
    "@delorun/home-auth": "workspace:*",
    "@delorun/plugin-scaffold": "workspace:*",
    "@delorun/profile-safety": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-timer": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-api-gateway": "workspace:*",
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-store": "workspace:*",
    "@deepseek-ai/dsh-client-test-runtime": "workspace:*",
    "@deepseek-ai/dsh-client-ui-layout": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-hmr": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-plugin-manager": "workspace:*",
    "@deepseek-ai/dsh-sandbox-policy": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tool-executor-native": "workspace:*",
    "@deepseek-ai/dsh-tool-testkit": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-user-approval": "workspace:*",
    "@deepseek-ai/dsh-workspace": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~18.3.1",
    "chokidar": "5.0.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2"
  },
  "delorun": {
    "state": "shipped"
  }
}
