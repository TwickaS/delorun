{
  "name": "@delorun/plugin-theme",
  "description": "Delorun's look across the studio: the Soft palette, the accent and Delorun's typefaces laid over upstream's theme tokens, the Appearance and Conversation sections, and the one switch back to the stock look",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./controls": "./src/client/controls/index.ts",
    "./assets/*": "./lib/assets/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/assets",
    "locale/*.json",
    "fonts",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/copy-brand-fonts.ts && tsc -b tsconfig.json && tsdown",
    "typecheck": "tsc -b tsconfig.json && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.tests.client.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-store": "workspace:*",
    "@deepseek-ai/dsh-client-test-runtime": "workspace:*",
    "@deepseek-ai/dsh-client-ui-chat": "workspace:*",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:*",
    "@deepseek-ai/dsh-client-ui-model-selection": "workspace:*",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-client-ui-theme": "workspace:*",
    "@deepseek-ai/dsh-client-ui-workspace": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@deepseek-ai/dsh-official-bundles": "workspace:*",
    "@deepseek-ai/dsh-package-manifest": "workspace:*",
    "@deepseek-ai/dsh-settings": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2"
  },
  "delorun": {
    "state": "shipped"
  },
  "dependencies": {
    "@delorun/brand": "workspace:*",
    "@delorun/home-auth": "workspace:*",
    "@delorun/settings-controls": "workspace:*"
  }
}