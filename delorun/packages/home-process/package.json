  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@delorun/contract-home-layout": "workspace:*",
    "@delorun/contract-home-process": "workspace:*",
    "@delorun/contract-operational-logs": "workspace:*",
    "@delorun/home": "workspace:*",
    "@delorun/logs": "workspace:*",
    "@delorun/supervisor": "workspace:*",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-sandbox": "workspace:*",
    "@deepseek-ai/dsh-sandbox-local": "workspace:*",
    "@deepseek-ai/node-addon-system": "workspace:~"
  },
  "delorun": {
    "state": "shipped"
  }
