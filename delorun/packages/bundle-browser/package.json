{
  "name": "@delorun/bundle-browser",
  "description": "Browser as an optional bundle: lets the agent open pages, click and read in a Chromium browser on this computer, through Playwright. Off until the person turns it on",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-browser-use": "workspace:*",
    "@deepseek-ai/dsh-experimental-browser-use-chrome-devtools-mcp": "workspace:*",
    "@deepseek-ai/dsh-experimental-browser-use-playwright-mcp": "workspace:*",
    "@deepseek-ai/dsh-experimental-browser-use-stagehand-native": "workspace:*"
  },
  "delorun": {
    "state": "experimental",
    "pack": true,
    "requires": {
      "browser-use-playwright-mcp": {
        "needs": [
          {
            "kind": "playwright-browser",
            "via": [
              "@deepseek-ai/dsh-experimental-browser-use-playwright-mcp",
              "@playwright/mcp"
            ],
            "browser": "chromium",
            "server": "playwright-mcp"
          }
        ],
        "fix": {
          "kind": "playwright-install"
        }
      }
    }
  }
}
