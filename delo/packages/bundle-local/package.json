{
  "name": "@delo/bundle-local",
  "description": "Delo's local bundle: the layer that Delo's CLI profiles add over upstream's web template, with Delo's privacy defaults for upstream's opt-ins and the Privacy section in Settings",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./profile": "./src/profile.ts",
    "./rows": "./src/rows.ts",
    "./update-gate": "./src/update-gate.ts",
    "./update-check": "./src/update-check.ts",
    "./profile-versions": "./src/profile-versions.ts",
    "./statements": "./src/client/locales.ts",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "locale/*.json",
    "cordis.patch.yml",
    "src/profile.ts",
    "src/rows.ts",
    "src/update-gate.ts",
    "src/update-check.ts",
    "src/profile-versions.ts",
    "src/client/versions-api.ts",
    "src/client/locales.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown",
    "typecheck": "tsc -b tsconfig.json && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.tests.client.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-official-bundles": "workspace:*",
    "@deepseek-ai/dsh-plugin-manager": "workspace:*",
    "@delo/contract-setup-answers": "workspace:*",
    "@delo/contract-update-report": "workspace:*",
    "@delo/home-auth": "workspace:*",
    "@delo/plugin-delegation-consent": "workspace:*",
    "@delo/plugin-fetch-guard": "workspace:*",
    "@delo/plugin-install-check": "workspace:*",
    "@delo/plugin-instruction-consent": "workspace:*",
    "@delo/plugin-mcp-consent": "workspace:*",
    "@delo/plugin-permission-defaults": "workspace:*",
    "@delo/plugin-schedule-consent": "workspace:*",
    "@delo/plugin-trash": "workspace:*",
    "@delo/profile-safety": "workspace:*",
    "@delo/reach": "workspace:*",
    "@delo/settings-controls": "workspace:*",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-agent-loop-testkit": "workspace:*",
    "@deepseek-ai/dsh-api-remotes": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-product-analytics": "workspace:*",
    "@deepseek-ai/dsh-client-store": "workspace:*",
    "@deepseek-ai/dsh-client-test-runtime": "workspace:*",
    "@deepseek-ai/dsh-client-ui-approval": "workspace:*",
    "@deepseek-ai/dsh-client-ui-permission-presets": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings-general": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-deepseek-llm-api-extensions": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-host-product-telemetry-otel": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "workspace:*",
    "@deepseek-ai/dsh-llm-mock-server": "workspace:*",
    "@deepseek-ai/dsh-otel": "workspace:*",
    "@deepseek-ai/dsh-permission-presets": "workspace:*",
    "@deepseek-ai/dsh-sandbox": "workspace:*",
    "@deepseek-ai/dsh-sandbox-local": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-log-deepseek": "workspace:*",
    "@deepseek-ai/dsh-subprocess-local": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tool-executor-native": "workspace:*",
    "@deepseek-ai/dsh-tool-fs-search": "workspace:*",
    "@deepseek-ai/dsh-tool-testkit": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@delo/contract-home-layout": "workspace:*",
    "@types/react": "~18.3.1",
    "js-yaml": "^4.3.2",
    "react": "^18.2.0",
    "tsdown": "^0.22.2"
  },
  "delo": {
    "state": "shipped"
  }
}
