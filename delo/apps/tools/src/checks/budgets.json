{
  "$comment": "Each check's resident memory at its peak, in GiB, and whether it must run alone; a worker-count check scales its figure per worker. `checks` is keyed by check id or by id family (`typecheck`, `gates`): the most specific entry wins, and an id with no entry fails the run at load. `tiers` gives the time budget of a tier's run in seconds, and a check's `seconds`, where it has one, is its wall-clock budget, which the check's own command reports a run over. The runner schedules checks so their memory sums stay inside the run's ceiling, and declines one that cannot fit at all.",
  "tiers": {
    "pre-commit": { "seconds": 5 }
  },
  "checks": {
    "boundary": { "memoryGiB": 0.3 },
    "gates": { "memoryGiB": 0.5 },
    "whitespace": { "memoryGiB": 0.1 },
    "jsdoc": { "memoryGiB": 1.5 },
    "typecheck:upstream": { "memoryGiB": 2.5 },
    "typecheck": { "memoryGiB": 1 },
    "tests:fork": { "memoryGiB": 0.5, "perWorker": true },
    "tests:fork:integration": { "memoryGiB": 1, "perWorker": true },
    "tests:moved-clock": { "memoryGiB": 0.5, "perWorker": true },
    "tests:docker": { "memoryGiB": 1 },
    "tests:upstream-changed": { "memoryGiB": 0.6, "perWorker": true },
    "tests:snapshots": { "memoryGiB": 0.6, "perWorker": true, "exclusive": true },
    "parity-switches": { "memoryGiB": 0.5 },
    "parity-replay": { "memoryGiB": 0.6, "perWorker": true, "exclusive": true },
    "parity-replay:control": { "memoryGiB": 1.5 },
    "tests:web-changed": { "memoryGiB": 5, "exclusive": true, "seconds": 1200 },
    "tests:closure": { "memoryGiB": 4, "exclusive": true, "seconds": 1800 },
    "journey": { "memoryGiB": 6, "exclusive": true, "seconds": 1800 },
    "build:artifacts": { "memoryGiB": 4 },
    "build:delo": { "memoryGiB": 1.5 },
    "generate:native": { "memoryGiB": 1 },
    "benchmark:delo": { "memoryGiB": 6, "exclusive": true },
    "docs-site": { "memoryGiB": 2, "seconds": 900 },
    "generated:notices": { "memoryGiB": 1, "seconds": 120 }
  }
}
