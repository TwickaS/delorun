{
  "name": "@delo/npm-launcher",
  "description": "The Delo launcher npm serves as `delorun`: it verifies and installs the release its channel names through @delo/install, refuses a runtime it cannot verify, and starts the installed runtime through its own Node executable (contract C1's launch protocol 1)",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "delorun": "tsx src/entry.ts",
    "pack:launcher": "tsx src/build.ts"
  },
  "dependencies": {
    "@delo/contract-home-layout": "workspace:*",
    "@delo/contract-release-manifest": "workspace:*",
    "@delo/contract-update-report": "workspace:*",
    "@delo/contract-verification-checks": "workspace:*",
    "@delo/home": "workspace:*",
    "@delo/install": "workspace:*",
    "@delo/logs": "workspace:*",
    "@delo/release-formats": "workspace:*",
    "@delo/release-verify": "workspace:*",
    "@delo/runtime-store": "workspace:*",
    "@delo/update": "workspace:*",
    "semver": "^7.8.5"
  },
  "delo": {
    "state": "shipped"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@types/semver": "^7.8.0",
    "tsdown": "^0.22.2"
  }
}
