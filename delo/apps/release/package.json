{
  "name": "@delo/release",
  "description": "Delo's release tooling: the changelog gate and release-notes assembly, the deterministic runtime closure build, the rebuild comparison, signing and verification of release metadata, the SBOM and the dependency advisory check.",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    "./archive/*": "./src/archive/*.ts",
    "./log/*": "./src/log/*.ts",
    "./sign/*": "./src/sign/*.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@delo/contract-release-log": "workspace:*",
    "@delo/contract-release-manifest": "workspace:*",
    "@delo/contract-update-report": "workspace:*",
    "@delo/release-formats": "workspace:*",
    "@delo/runtime-closure": "workspace:*",
    "@delo/tools": "workspace:*",
    "@delo/update": "workspace:*",
    "@noble/curves": "^2.4.0",
    "extract-zip": "^2.0.1",
    "ignore": "^7.0.8",
    "semver": "^7.8.5",
    "tar": "^7.5.22",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@delo/bundle-local": "workspace:*",
    "@types/semver": "^7.8.0"
  },
  "delo": {
    "state": "shipped"
  }
}
